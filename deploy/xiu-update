#!/bin/bash
# 手动更新 xiu-online 测试服；不会访问或修改原版 xiu 仓库和服务。
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
DIR=/opt/xiu-online
SERVICE=xiu-online-test
PUBLIC_IP="$(curl -4fsS --max-time 8 https://api.ipify.org || true)"
if [[ ! "$PUBLIC_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "无法自动探测服务器公网 IPv4；请检查服务器的出网连接后重试。" >&2
  exit 1
fi
printf '>>> 拉取 hyp3699/xiu-online 的 main 分支\n'
git -C "$DIR" fetch --depth 1 origin main
git -C "$DIR" reset --hard FETCH_HEAD
install -m 0755 "$DIR/deploy/xiu-update" /usr/local/bin/xiu-online-update
install -m 0755 "$DIR/deploy/uninstall.sh" /usr/local/bin/xiu-online-uninstall
(cd "$DIR/server" && npm ci --omit=dev --no-audit --no-fund)
# 给静态脚本生成内容哈希版本，避免测试服客户端继续使用旧缓存。
python3 - "$DIR/web" <<'PY'
import hashlib, pathlib, re, sys
web = pathlib.Path(sys.argv[1]); index = web / "index.html"
text = index.read_text(encoding="utf-8")
def update(match):
    prefix, rel = match.group(1), match.group(2)
    file = web / rel
    version = hashlib.sha256(file.read_bytes()).hexdigest()[:10] if file.is_file() else "0"
    return f'{prefix}?v={version}"'
text = re.sub(r'((?:src|href)="([^"?:]+))\?v=[^"]*"', update, text)
index.write_text(text, encoding="utf-8")
PY
install -m 0644 "$DIR/deploy/xiu-server.service" "/etc/systemd/system/${SERVICE}.service"
systemctl daemon-reload
systemctl restart "$SERVICE"
systemctl is-active --quiet "$SERVICE"
for _ in $(seq 1 20); do curl -fsS http://127.0.0.1:18301/health >/dev/null && break || sleep 1; done
curl -fsS http://127.0.0.1:18301/health
for D in /etc/nginx/conf.d/central_vps_users/*/ /etc/nginx/snippets/; do
  [ -f "${D}xiu-online-test.conf" ] && install -m 0644 "$DIR/deploy/nginx-xiuxian.conf" "${D}xiu-online-test.conf"
done
IP_NGX_TMP=$(mktemp)
sed "s/__XIU_PUBLIC_IP__/${PUBLIC_IP}/g" "$DIR/deploy/nginx-xiuxian-ip.conf" > "$IP_NGX_TMP"
install -m 0644 "$IP_NGX_TMP" /etc/nginx/conf.d/xiu-online-ip-test.conf
rm -f "$IP_NGX_TMP"
nginx -t
systemctl reload nginx
printf '\n更新完成。测试入口：http://%s/（HTTP，仅供临时测试）\nCloudflare Tunnel origin：http://127.0.0.1:18302（HTTP）\n' "$PUBLIC_IP"
