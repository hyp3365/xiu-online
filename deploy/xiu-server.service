[Unit]
Description=Xiu (问道长生) save server
After=network.target

[Service]
User=xiu
Group=xiu
Environment=XIU_DB=/var/lib/xiu/xiu.db
Environment=XIU_HOST=127.0.0.1
Environment=XIU_PORT=18300
# 多线程时 glibc 默认会开很多内存池，限制成 2 个，常驻内存更小
Environment=MALLOC_ARENA_MAX=2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/xiu/server/server.py
Restart=always
RestartSec=3
# 日志只写到数据目录的一个文件（不进系统日志），xiu-update 时超过 1MB 自动只保留最后 200KB
StandardOutput=append:/var/lib/xiu/server.log
StandardError=append:/var/lib/xiu/server.log

[Install]
WantedBy=multi-user.target
